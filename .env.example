# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL (development examples only)
POSTGRES_USER=sekolah_dev
POSTGRES_PASSWORD=
POSTGRES_DB=sekolah_ormawa_dev
DATABASE_URL=postgresql://sekolah_dev:@localhost:55432/sekolah_ormawa_dev?schema=public
DIRECT_DATABASE_URL=postgresql://sekolah_dev:@localhost:55432/sekolah_ormawa_dev?schema=public
TEST_DATABASE_URL=postgresql://sekolah_dev:@localhost:55432/sekolah_ormawa_test?schema=public

# Authentication
AUTH_SECRET=
SESSION_COOKIE_NAME=sekolah_session
SESSION_MAX_AGE_SECONDS=28800
SESSION_IDLE_TIMEOUT_SECONDS=900
SESSION_UPDATE_AGE_SECONDS=60
PASSWORD_RESET_TTL_SECONDS=3600
TEMP_PASSWORD_TTL_SECONDS=86400
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
PASSWORD_MAX_LENGTH=128
SEED_SUPER_ADMIN_PASSWORD=
SEED_DEPT_PJ_PASSWORD=

# Public registration (fail-closed; development examples only)
REGISTRATION_SUBMISSION_ENABLED=false
REGISTRATION_DRAFT_TTL_SECONDS=604800
REGISTRATION_UPLOAD_TTL_SECONDS=86400
REGISTRATION_CONFIRMATION_TTL_SECONDS=900
MOTIVATION_MIN_WORDS=100
ESSAY_MIN_WORDS=1
ESSAY_MAX_WORDS=1000
PORTFOLIO_MAX_FILES=5
PORTFOLIO_MAX_FILE_BYTES=5242880
PORTFOLIO_URL_MAX_LENGTH=2048

# Security and storage
IP_HASH_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET_CANDIDATES=sekolah-candidates-private
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_PRIVATE_ROOT=private

# Email, jobs, abuse protection, and observability
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_SINK_ROOT=email-sink
EMAIL_OUTBOX_MAX_ATTEMPTS=5
CRON_SECRET=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=info
