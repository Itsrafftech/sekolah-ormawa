# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL (development examples only)
# Port 15432 (not Postgres's default 5432/the earlier 55432) is the
# permanent host port for local Docker Postgres - see RUNBOOK.md Setup
# lokal for why (Windows WinNAT dynamic port exclusion).
POSTGRES_USER=sekolah_dev
POSTGRES_PASSWORD=
POSTGRES_DB=sekolah_ormawa_dev
DATABASE_URL=postgresql://sekolah_dev:@localhost:15432/sekolah_ormawa_dev?schema=public
DIRECT_DATABASE_URL=postgresql://sekolah_dev:@localhost:15432/sekolah_ormawa_dev?schema=public
TEST_DATABASE_URL=postgresql://sekolah_dev:@localhost:15432/sekolah_ormawa_test?schema=public
# Pool size for the shared Prisma client (src/lib/db.ts). Leave at the
# app default here - the integration test suite overrides this lower
# itself (vitest.integration.config.ts), no need to set it for dev/prod.
DATABASE_CONNECTION_LIMIT=20
# How long $transaction() queues for a free pooled connection before
# giving up (Prisma's own stock default). Leave as-is here - the
# integration test suite raises this itself for its concurrency race
# tests, no need to set it for dev/prod.
DATABASE_TRANSACTION_MAX_WAIT_MS=2000
# How long a $transaction() BODY (lock.ts/selection.ts) may run before
# Prisma cancels it. Leave at 15000 here for dev/prod - the integration
# test suite raises this itself (30000, headroom for its 50/60-way
# concurrency race tests). See DECISIONS.md ADR-042 - this was never the
# actual root cause of those tests' flakiness (a real connection-pool
# self-deadlock in the audit-log write was), but is kept as a documented
# safety margin.
PRISMA_TRANSACTION_TIMEOUT_MS=15000

# Authentication
AUTH_SECRET=
SESSION_COOKIE_NAME=sekolah_session
SESSION_MAX_AGE_SECONDS=28800
SESSION_IDLE_TIMEOUT_SECONDS=900
SESSION_UPDATE_AGE_SECONDS=60
PASSWORD_RESET_TTL_SECONDS=3600
TEMP_PASSWORD_TTL_SECONDS=86400
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
PASSWORD_MAX_LENGTH=128
SEED_SUPER_ADMIN_PASSWORD=
SEED_DEPT_PJ_PASSWORD=

# Public registration (fail-closed; development examples only)
REGISTRATION_SUBMISSION_ENABLED=false
REGISTRATION_DRAFT_TTL_SECONDS=604800
REGISTRATION_UPLOAD_TTL_SECONDS=86400
REGISTRATION_CONFIRMATION_TTL_SECONDS=900
MOTIVATION_MIN_WORDS=100
ESSAY_MIN_WORDS=1
ESSAY_MAX_WORDS=1000
# Phase D - "Portofolio via URL Google Drive" (ADR-045): file-upload caps
# (PORTFOLIO_MAX_FILES/PORTFOLIO_MAX_FILE_BYTES/BUDGET_PLAN_MAX_FILE_BYTES)
# retired - Medbrand/Badmedbrnd/Komanggar portfolio+RAB are now a plain
# Google Drive URL. PORTFOLIO_URL_MAX_LENGTH kept, reused as that URL's
# max length.
PORTFOLIO_URL_MAX_LENGTH=2048

# Security and storage
IP_HASH_SECRET=
# Production private storage: self-hosted MinIO on Contabo (S3-compatible;
# replaces the earlier Supabase Storage plan - see ADR-035). Required
# in production only; development/test use local disk instead and leave
# these blank.
STORAGE_BUCKET_CANDIDATES=sekolah-candidates-private
# http://minio:9000 when the app talks to the minio service inside
# docker-compose.prod.yml's internal Docker network (not a public URL).
MINIO_ENDPOINT=
MINIO_REGION=us-east-1
# MINIO_ACCESS_KEY/MINIO_SECRET_KEY: the app's own S3 credentials. Can
# reuse MINIO_ROOT_USER/MINIO_ROOT_PASSWORD below for a simple single-app
# deployment, or (recommended) create a separate least-privilege access
# key scoped to just STORAGE_BUCKET_CANDIDATES via the MinIO console/`mc`
# CLI - see RUNBOOK.md §Deployment readiness.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_PRIVATE_ROOT=private
# MINIO_ROOT_USER/MINIO_ROOT_PASSWORD: only read by the `minio` service
# itself in docker-compose.prod.yml (container bootstrap credentials), not
# by the Next.js app - production only, irrelevant in development.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Email, jobs, abuse protection, and observability
# Production email: Resend (resend.com), via its HTTP API/SDK, not SMTP.
# Required in production only; development/test use the local file sink
# instead and leave these blank.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_SINK_ROOT=email-sink
EMAIL_OUTBOX_MAX_ATTEMPTS=5
CRON_SECRET=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=info
